# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# Quickest local setup: SQLite, nothing to install.
DB_ENGINE=django.db.backends.sqlite3
# To use PostgreSQL instead, delete the DB_ENGINE line above and set these:
# DB_NAME=online_bookstore
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# --- Celery and Redis (only needed to send emails and SMS) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Email ---
# By default emails are printed in the Celery worker terminal.
# To send real emails (for example through Gmail with an app password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=you@gmail.com

# --- SMS ---
# By default SMS messages are printed in the Celery worker terminal.
# To use Twilio (sending to India also needs DLT registration):
# SMS_BACKEND=notifications.sms.TwilioSMSBackend
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_DEFAULT_COUNTRY_CODE=+91